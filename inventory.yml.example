cluster_name: MyCluster
dse_version: "6.8"         # optional — auto-detected if omitted

defaults:
  # ── SSH login account ─────────────────────────────────────────────────────
  # 'automaton' is the account used to open the SSH connection.
  ssh_user: automaton
  ssh_key:  ~/.ssh/id_rsa
  ssh_port: 22

  # ── DSE OS account ────────────────────────────────────────────────────────
  # 'cassandra' owns the keystore/truststore files, cassandra.yaml, and
  # all DSE configuration under /etc/dse/.
  # The tool runs all file reads (keytool, stat, cat) as this user via:
  #   sudo -u cassandra -n <command>
  # Requirement on each node:
  #   automaton ALL=(cassandra) NOPASSWD: ALL
  #   (or scope it to specific binaries — see README)
  dse_user: cassandra
  use_sudo: true            # sudo -u cassandra  (set false to use 'su' instead)

  # ── Remote config paths ───────────────────────────────────────────────────
  cassandra_yaml: /etc/dse/cassandra/cassandra.yaml
  ssl_dir:        /etc/dse/ssl

nodes:
  - host: 10.1.1.1
    name: node1
    dc:   dc1

  - host: 10.1.1.2
    name: node2
    dc:   dc1

  - host: 10.1.1.3
    name: node3
    dc:   dc2

# ── OpsCenter (optional) ─────────────────────────────────────────────────────
# opscenter:
#   host:         10.1.1.10
#   ssh_user:     automaton
#   ssh_key:      ~/.ssh/id_rsa
#   dse_user:     opscenter   # OS user that owns opscenterd.conf
#   use_sudo:     true
#   conf:         /etc/opscenter/opscenterd.conf
#   cluster_conf: /etc/opscenter/clusters  # dir — {cluster_name}.conf must exist here
#   ssl_dir:      /var/lib/opscenter/ssl
